<?xml version="1.0" encoding="utf-8"?>
<robot name="R2_V3_Assembly">
  
  <link name="base_link">
    <inertial>
      <origin xyz="-0.0070142 0.40653 -0.033544" rpy="0 0 0" />
      <mass value="12.092" />
      <inertia
        ixx="0.11827"
        ixy="5.2038E-06"
        ixz="0.0043428"
        iyy="0.16973"
        iyz="0.0005168"
        izz="0.16323" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot2_description/meshes/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.86667 0.9098 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot2_description/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Ultrasonic Sensor Link -->
  <link name="ultrasonic_sensor_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.03 0.01"/>
      </geometry>
      <material name="sensor_blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.03 0.01"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint connecting ultrasonic sensor to base_link -->
  <joint name="ultrasonic_sensor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_sensor_link"/>
    <origin xyz="0.25 0 0.26" rpy="0 -1.5708 0"/>  <!-- Rotated -90° -->
  </joint>

  <!-- Gazebo-specific sensor configuration -->
  <gazebo reference="ultrasonic_sensor_link">
    <sensor name="ultrasonic_front" type="gpu_ray">
      <pose>0 0 0 0 0 0</pose>
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <topic>ultrasonic_front</topic>
      
      <ray>
        <scan>
          <horizontal>
            <!-- CHANGE: Single ray like HC-SR04 -->
            <samples>1</samples>  <!-- Was 5, now 1 -->
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>  <!-- Was -0.26 -->
            <max_angle>0.0</max_angle>  <!-- Was 0.26 -->
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>  <!-- HC-SR04 minimum: 2cm -->
          <max>4.0</max>   <!-- HC-SR04 maximum: 4m -->
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.003</stddev>  <!-- Small noise like real HC-SR04 -->
        </noise>
      </ray>
    </sensor>
  </gazebo>

  <!-- Rest of your robot links and joints... -->
  <link name="StepClimbing_Middle">
