    <parent link="base_link" />
    <child link="Wheel_FL" />
    <axis xyz="1 0 0" />
  </joint>

  <link name="Wheel_FR">
    <inertial>
      <origin xyz="0 0 -2.2204E-16" rpy="0 0 0" />
      <mass value="0.18024" />
      <inertia
        ixx="0.00013229"
        ixy="-1.3657E-10"
        ixz="-9.1547E-10"
