  <!-- Wheel friction for Gazebo -->
  <gazebo reference="Wheel_FL">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="Wheel_FR">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="Wheel_ML">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="Wheel_MR">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="Wheel_BL">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="Wheel_BR">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <!-- ROS2 Control -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>

    <joint name="Front_Wheel_L">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>

    <joint name="Fornt_Wheel_R">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>

    <joint name="Middle_Wheel_L">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>

    <joint name="Middle_Wheel_R">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>

    <joint name="Back_Wheel_L">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>

    <joint name="Back_Wheel_R">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>

    <joint name="sliding_M">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <joint name="Sliding_B">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    
    <!-- Prismatic joints (position control) -->
    <joint name="sliding_M">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="Sliding_B">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>
  <!-- Simple Differential Drive Plugin -->
  <gazebo>
    <plugin
      filename="libignition-gazebo-diff-drive-system.so"
      name="ignition::gazebo::systems::DiffDrive">
      
      <!-- Wheel joints -->
      <left_joint>Front_Wheel_L</left_joint>
      <left_joint>Middle_Wheel_L</left_joint>
      <left_joint>Back_Wheel_L</left_joint>
      
      <right_joint>Fornt_Wheel_R</right_joint>
      <right_joint>Middle_Wheel_R</right_joint>
      <right_joint>Back_Wheel_R</right_joint>
      
      <!-- Kinematics -->
      <wheel_separation>0.407</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      
      <!-- Topic -->
      <topic>cmd_vel</topic>
      
      <!-- Frames -->
      <odom_publish_frequency>50</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      
    </plugin>
  </gazebo>

<!-- Joint Position Controller for Middle Joint -->
  <gazebo>
    <plugin
      filename="libignition-gazebo6-joint-position-controller-system.so"
      name="ignition::gazebo::systems::JointPositionController">
      <joint_name>sliding_M</joint_name>
      <topic>sliding_M_cmd</topic>
      <p_gain>100</p_gain>
      <i_gain>1</i_gain>
      <d_gain>10</d_gain>
    </plugin>
  </gazebo>

  <!-- Joint Position Controller for Back Joint -->
  <gazebo>
    <plugin
      filename="libignition-gazebo6-joint-position-controller-system.so"
      name="ignition::gazebo::systems::JointPositionController">
      <joint_name>Sliding_B</joint_name>
      <topic>Sliding_B_cmd</topic>
      <p_gain>100</p_gain>
      <i_gain>1</i_gain>
      <d_gain>10</d_gain>
    </plugin>
  </gazebo>
  
</robot>
