      <origin xyz="0 6.9389E-18 0" rpy="0 0 0" />
      <mass value="0.18024" />
      <inertia
        ixx="0.00013229"
        ixy="-8.9062E-10"
        ixz="-2.5206E-10"
        iyy="8.8497E-05"
        iyz="6.1673E-09"
        izz="8.8477E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot2_description/meshes/Wheel_FL.STL" />
