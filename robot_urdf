    </collision>
  </link>

  <joint name="Sliding_B" type="prismatic">
    <origin xyz="-0.0005 0 -0.2864" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="StepClimbing_Back" />
    <axis xyz="0 1 0" />
    <limit lower="-2.0" upper="0" effort="100" velocity="10" />
  </joint>

  <link name="Wheel_BL">
