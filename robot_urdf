    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot2_description/meshes/StepClimbing_Middle.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="sliding_M" type="prismatic">
    <origin xyz="-0.0005 0 -0.070089" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="StepClimbing_Middle" />
    <axis xyz="0 1 0" />
    <limit lower="-2.0" upper="2.0" effort="100" velocity="10" />
  </joint>

