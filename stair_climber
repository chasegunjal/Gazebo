#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from sensor_msgs.msg import LaserScan
from geometry_msgs.msg import Twist
from std_msgs.msg import Float64
import time

class StairClimber(Node):
    def __init__(self):
        super().__init__('stair_climber')
        
        # Subscribers
        self.sensor_sub = self.create_subscription(
            LaserScan, '/ultrasonic_front', self.sensor_callback, 10
        )
        
        # Publishers
        self.cmd_vel_pub = self.create_publisher(Twist, '/cmd_vel', 10)
        
        # Joint command publishers (these will work after adding plugin)
        self.middle_joint_pub = self.create_publisher(
            Float64, '/sliding_M_cmd', 10
        )
        
        self.back_joint_pub = self.create_publisher(
            Float64, '/Sliding_B_cmd', 10
        )
        
        # State machine
        self.state = "APPROACHING"
        self.state_start_time = None
        self.climb_distance = 0.15
        self.current_distance = 999.0
        self.slow_distance = 0.50      # Slow down at 50cm
        self.normal_speed = 0.5        # Normal speed
        self.slow_speed = 0.1 
        
        # Timer for state machine (10 Hz)
        self.timer = self.create_timer(0.1, self.state_machine)
        
        self.get_logger().info('🤖 Stair Climber Started!')
        self.get_logger().info('Waiting for obstacle...')
    
    def sensor_callback(self, msg):
        distance = msg.ranges[0]
        if distance != float('-inf') and distance != float('inf'):
            self.current_distance = distance
        else:
            self.current_distance = 999.0
    
    def state_machine(self):
        if self.state == "APPROACHING":
            if self.current_distance > self.slow_distance:
                self.move_forward(self.normal_speed)
                self.get_logger().info(
                    f'🚗 APPROACHING: {self.current_distance:.2f}m',
                    throttle_duration_sec=1.0
                )

            elif self.current_distance <= self.slow_distance and self.current_distance > self.climb_distance:
                self.move_forward(self.slow_distance)
                self.get_logger().info(
                    f'🚗 SLOWING DOWN:{self.current_distance:.2f}m',throttle_duration_sec=1.0
                )

            else:
                self.stop()
                self.get_logger().info('🛑 Obstacle reached! Starting lift...')
                # Extend both joints to lift the robot
                self.set_middle_joint(-0.2)   # Extend to max
                self.set_back_joint(-0.2)    # Extend to max (negative for this joint)
                self.state = "LIFTING"
                self.state_start_time = time.time()
        
        elif self.state == "LIFTING":
            elapsed = time.time() - self.state_start_time
            self.get_logger().info(
                f'⬆️  LIFTING: {elapsed:.1f}/2.0s',
                throttle_duration_sec=0.5
            )
            if elapsed >= 2.0:
                self.get_logger().info('✅ Lift complete! Starting climb...')
                self.state = "CLIMBING"
                self.state_start_time = time.time()
        
        elif self.state == "CLIMBING":
            self.move_forward(0.2)
            elapsed = time.time() - self.state_start_time
            self.get_logger().info(
                f'🧗 CLIMBING: {elapsed:.1f}/7.0s',
                throttle_duration_sec=0.5
            )
            if elapsed >= 7.0:
                self.get_logger().info('⬇️  Lowering middle joint...')
                self.set_middle_joint(0.0)  # Retract middle
                self.state = "LOWERING_MIDDLE"
                self.state_start_time = time.time()
        
        elif self.state == "LOWERING_MIDDLE":
            self.move_forward(0.2)
            elapsed = time.time() - self.state_start_time
            self.get_logger().info(
                f'⬇️  LOWERING MIDDLE: {elapsed:.1f}/5.0s',
                throttle_duration_sec=0.5
            )
            if elapsed >= 5.0:
                self.get_logger().info('⬇️  Lowering back joint...')
                self.set_back_joint(0.0)  # Retract back
                self.state = "LOWERING_BACK"
                self.state_start_time = time.time()
        
        elif self.state == "LOWERING_BACK":
            self.move_forward(0.2)
            elapsed = time.time() - self.state_start_time
            self.get_logger().info(
                f'⬇️  LOWERING BACK: {elapsed:.1f}/5.0s',
                throttle_duration_sec=0.5
            )
            if elapsed >= 5.0:
                self.stop()
                self.get_logger().info('🎉 CLIMB COMPLETE!')
                self.state = "DONE"
        
        elif self.state == "DONE":
            self.stop()
            self.get_logger().info('✅ Finished!', throttle_duration_sec=5.0)
    
    def move_forward(self, speed):
        msg = Twist()
        msg.linear.x = speed
        self.cmd_vel_pub.publish(msg)
    
    def stop(self):
        self.cmd_vel_pub.publish(Twist())
    
    def set_middle_joint(self, position):
        msg = Float64()
        msg.data = position
        self.middle_joint_pub.publish(msg)
        self.get_logger().info(f'📤 Middle joint → {position}m')
    
    def set_back_joint(self, position):
        msg = Float64()
        msg.data = position
        self.back_joint_pub.publish(msg)
        self.get_logger().info(f'📤 Back joint → {position}m')

def main():
    rclpy.init()
    node = StairClimber()
    
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        node.get_logger().info('Shutting down...')
        node.stop()
    finally:
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()
